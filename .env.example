# Token del bot. Developer Portal > tu app > Bot > Reset Token.
DISCORD_TOKEN=

# Application ID. Developer Portal > tu app > General Information.
# Sirve para registrar los slash commands (npm run deploy).
DISCORD_CLIENT_ID=

# ID del server de pruebas. Con esto los slash aparecen al instante;
# vacio = registro global y Discord tarda hasta 1 hora.
DISCORD_GUILD_ID=

# Prefijo de los comandos de texto. "maggy" -> "maggy ping"
PREFIX=maggy

# API key de weatherapi.com (plan gratis). Solo la usa el comando clima.
WEATHERAPI=

# Poner en 1 para ver el handshake de voz en los logs (debug del comando di).
VOICE_DEBUG=

# Clientes de YouTube que prueba yt-dlp, en orden. Vacio = default,web_embedded.
# web_embedded no necesita PO Token, sirve cuando el server queda marcado como bot.
YTDLP_PLAYER_CLIENTS=

# Ruta a un cookies.txt de YouTube dentro del contenedor. Ultimo recurso cuando
# YouTube pide verificacion desde la IP del server (ver el volumen comentado
# en docker-compose.yml).
YTDLP_COOKIES=

# Argumentos extra sueltos para yt-dlp, separados por espacios.
YTDLP_EXTRA_ARGS=
